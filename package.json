{
  "name": "moyapay",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @moyapay/api dev",
    "dev:worker": "pnpm --filter @moyapay/api dev:worker",
    "build": "pnpm --filter @moyapay/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @moyapay/api test",
    "e2e": "pnpm --filter @moyapay/api e2e",
    "format": "prettier --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:web": "pnpm --filter @moyapay/web exec next dev --port 3100",
    "build:web": "pnpm --filter @moyapay/web build",
    "screenshots": "pnpm --filter @moyapay/web exec node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
