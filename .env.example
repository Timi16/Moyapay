# MoyaPay environment. Copy to .env and fill in. Every variable in apps/api/src/config/env.ts
# is listed here (a test checks it). Never commit .env.

NODE_ENV=development
PORT=4200
# Interface to listen on. Keep 127.0.0.1 when a reverse proxy (Caddy) runs on the same machine.
HOST=127.0.0.1
# Proxy hops in front of the API: 1 = Caddy; 2 = Caddy then the web app (browser -> web -> API).
TRUST_PROXY=1
LOG_LEVEL=info

# Postgres. Locally: `pnpm db:up` (docker-compose.dev.yml). On the server: `docker compose up -d`
# (compose.yaml), which also needs this line with the same password as in DATABASE_URL:
# POSTGRES_PASSWORD=
DATABASE_URL=postgresql://moyapay:moyapay@localhost:5435/moyapay

# Stellar Testnet only: the API and worker refuse to boot with any other passphrase.
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Circle's testnet USDC. Every payment request asks for this asset.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Origin(s) of the web app, comma-separated, no trailing slash: CORS, the CSRF check and pay
# links (the first one). e.g. https://moyapay.xyz,https://www.moyapay.xyz
WEB_ORIGIN=http://localhost:3100
# Optional: cookie domain when the web app and the API are on sibling hosts, e.g. .moyapay.example
COOKIE_DOMAIN=

# 64 hex chars (32 bytes). Signs session ids and derives webhook signing secrets.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Development only: let status webhooks go to http:// and private addresses (a local receiver).
WEBHOOK_ALLOW_INSECURE=false

# Optional: Telegram alerts from the worker (stale watcher, disconnected streams)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
